{
  "$comment": "Voix en ligne Kounouzi (ADR 0036). La clé ElevenLabs et l'identifiant de voix ne sont JAMAIS ici : variables d'environnement du serveur (ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID, ELEVENLABS_MODEL_ID). Les phrases fixes listées dans `phrases` sont pré-générées par `pnpm voice:generate` et servies depuis `public/kounouzi/audio/voix/`.",
  "version": 1,
  "endpoint": "/api/voix",
  "manifestUrl": "/kounouzi/audio/voix/manifest.json",
  "languages": ["fr", "ar"],
  "maxTextLength": 1200,
  "fallbackToDevice": true,
  "rates": { "slow": 0.9, "normal": 1, "fast": 1.15 },
  "phrases": [
    "narration.arrived.start",
    "narration.arrived.question",
    "narration.arrived.heritage",
    "narration.arrived.challenge",
    "narration.arrived.treasure",
    "narration.arrived.donation",
    "narration.arrived.halt",
    "narration.passedStart",
    "narration.lastRound",
    "narration.halt",
    "narration.halt.lifted",
    "narration.halt.lost",
    "narration.revisit",
    "narration.shield",
    "narration.investment.lose",
    "narration.result.correct",
    "narration.result.partial",
    "narration.result.incorrect",
    "narration.duel.draw",
    "narration.challenge.ohNo",
    "narration.challenge.success",
    "narration.challenge.failure",
    "narration.challenge.skipped",
    "narration.recitation.mastered",
    "narration.year"
  ]
}
