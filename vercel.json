{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/jeu.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/jouer",
      "destination": "/api/jeu"
    },
    {
      "source": "/data.json",
      "destination": "/api/jeu?f=data"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/merci.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kounouzi-taupe.vercel.app"
        }
      ],
      "destination": "https://kounouzi.com/:path*",
      "permanent": true
    },
    {
      "source": "/jeu-de-societe-halal/:p*",
      "destination": "/jeu-de-societe-valeurs-islamiques/",
      "permanent": true
    },
    {
      "source": "/en/halal-board-game/:p*",
      "destination": "/en/board-game-islamic-values/",
      "permanent": true
    }
  ]
}